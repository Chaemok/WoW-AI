# 내부 AI 서버 실행 설정
MODEL_ID=Qwen/Qwen2.5-7B-Instruct
LOAD_IN_4BIT=1
ANALYZE_MAX_NEW_TOKENS=256
CHAT_MAX_NEW_TOKENS=160

# 서버 바인딩 설정
HOST=0.0.0.0
PORT=8000

# Runpod 캐시/다운로드 설정 예시
APP_CACHE_DIR=/workspace/WoW-AI/.cache
HF_HUB_DISABLE_XET=1
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0

# 데모 서버 연동 시 사용
CHATBOT_URL=http://127.0.0.1:8000
